# ── Language model (required) ─────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# deepseek-v4-flash (fast, default) or deepseek-v4-pro. The legacy names
# deepseek-chat / deepseek-reasoner were retired on 2026-07-24.
DEEPSEEK_MODEL=deepseek-v4-flash
# "disabled" (default) or "enabled" to turn on V4 thinking mode (slower, more tokens)
DEEPSEEK_THINKING=disabled
# Any other OpenAI-compatible endpoint: LLM_PROVIDER=openai-compatible + LLM_BASE_URL, LLM_API_KEY, LLM_MODEL

# ── Web search (strongly recommended; at least one) ───────────────────────
# Without a key the app falls back to keyless Bing/Google News RSS, which
# covers news but not WeChat, patents, jobs or events well.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
# Optional: raises Jina Reader limits for JS-heavy / bot-protected pages
JINA_API_KEY=
# Optional: free OpenAlex key (openalex.org/settings/api) raises the daily budget
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# ── Storage & accounts (required on Vercel) ───────────────────────────────
# Run supabase/migrations/0001_init.sql and 0002_accounts.sql once.
# SUPABASE_URL is the Project URL (https://<ref>.supabase.co). Without these, local dev uses ./.data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon / publishable key for Supabase Auth (used server-side only)
SUPABASE_ANON_KEY=

# ── Accounts & limits ─────────────────────────────────────────────────────
# Admins: unlimited generations, system status, owner notifications
ADMIN_EMAILS=
# Optional allow-list; leave both empty to let anyone sign up
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# SIGNUPS_DISABLED=1
USER_WEEKLY_RUN_LIMIT=3
GLOBAL_DAILY_RUN_LIMIT=30

# ── Notifications ─────────────────────────────────────────────────────────
NTFY_TOPIC_URL=https://ntfy.sh/lipid-plus
# NTFY_TOKEN=            # only for protected topics
# NTFY_DISABLED=1

# ── Links ─────────────────────────────────────────────────────────────────
# Public URL used in notification and auth-email links (defaults to the Vercel production URL)
APP_BASE_URL=

# ── Development ───────────────────────────────────────────────────────────
# MOCK_MODE=1  → offline sample data + mock LLM (fictional; never for real use)
# DATA_DIR=.data
# AUTH_SECRET=...   # signs local development session cookies
